rules_version = '2';

// Conxemar BMP Group: reglas de seguridad de Firestore.
// Lo que garantizan, aunque alguien manipule el código de la web:
//  - solo entran cuentas con correo @bmpiberica.com, @comercialgarmo.com o @repro.es
//    (o personas añadidas a mano en la colección "allowed")
//  - "creado por" (campo by) siempre es el usuario que escribe y no se puede cambiar
//  - solo el autor (o un administrador) borra lo suyo
//  - "visitado" de cada persona es privado
//  - solo m.aliena@ e i.huertas@bmpiberica.com (fijos aquí) cambian el catálogo y la lista de accesos
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function domainOk() {
      return myEmail().split('@')[1] in ['bmpiberica.com', 'comercialgarmo.com', 'repro.es'];
    }
    function isAllowed() {
      return signedIn()
        && (domainOk() || exists(/databases/$(database)/documents/allowed/$(myEmail())));
    }
    // Administradores: solo estos dos correos (fijos en las reglas, no editables desde la app).
    function isAdmin() {
      return signedIn() && myEmail() in ['m.aliena@bmpiberica.com', 'i.huertas@bmpiberica.com'];
    }
    function createdByMe() {
      return request.resource.data.by == request.auth.uid;
    }
    function authorKept() {
      return request.resource.data.by == resource.data.by;
    }
    function isAuthor() {
      return resource.data.by == request.auth.uid;
    }

    // Excepciones y administradores. Cada persona solo puede leer su propia ficha.
    match /allowed/{email} {
      allow get: if signedIn() && myEmail() == email;
      allow get, list, create, update, delete: if isAdmin();
    }

    // Ficha pública de cada usuario (para mostrar su nombre en "creado por").
    match /users/{uid} {
      allow read: if isAllowed();
      allow write: if isAllowed() && request.auth.uid == uid;

      // Datos privados de cada persona, como los expositores que ha marcado como visitados.
      match /private/{doc} {
        allow read, write: if isAllowed() && request.auth.uid == uid;
      }
    }

    // Catálogo de expositores y textos del stand.
    match /config/{doc} {
      allow read: if isAllowed();
      allow write: if isAdmin();
    }

    match /leads/{id} {
      allow read: if isAllowed();
      allow create: if isAllowed() && (createdByMe() || isAdmin());
      allow update: if isAllowed() && authorKept();
      allow delete: if isAllowed() && (isAuthor() || isAdmin());
    }

    match /notes/{id} {
      allow read: if isAllowed();
      allow create: if isAllowed() && (createdByMe() || isAdmin());
      allow update: if isAllowed() && authorKept() && (isAuthor() || isAdmin());
      allow delete: if isAllowed() && (isAuthor() || isAdmin());
    }

    match /expositores/{id} {
      allow read: if isAllowed();
      allow create: if isAllowed() && (createdByMe() || isAdmin());
      allow update: if isAllowed() && authorKept();
      allow delete: if isAllowed() && (isAuthor() || isAdmin());
    }

    // Fotos: un documento ligero (photoidx) y otro con la imagen (photodata).
    match /photoidx/{id} {
      allow read: if isAllowed();
      allow create: if isAllowed() && (createdByMe() || isAdmin());
      allow update: if false;
      allow delete: if isAllowed() && (isAuthor() || isAdmin());
    }
    match /photodata/{id} {
      allow read: if isAllowed();
      allow create: if isAllowed() && (createdByMe() || isAdmin())
        && request.resource.data.data is string
        && request.resource.data.data.size() < 400000;
      allow update: if false;
      allow delete: if isAllowed() && (isAuthor() || isAdmin());
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
